# Copy to .env; the single scripts/run.sh launcher loads it automatically.
# Python modules and installed commands use exported environment variables.
# HIVE_PROJECT_ROOT=/path/to/HiVe_mem
# HIVE_DATA_ROOT=/path/to/raw-data  # Contains memgallery/, h2hmem/, wma/.
# HIVE_MEMGALLERY_ROOT=/path/to/memgallery/benchmark/data
# HIVE_H2HMEM_ROOT=/path/to/h2hmem/dataset
# HIVE_WMA_ROOT=/path/to/wma/lifelong
# HIVE_OUTPUT_ROOT=/path/to/outputs  # Common root for memories, GVV, policies, and evaluation.
# HIVE_CONFIG=/path/to/runtime.json
# HIVE_POLICY_CONFIG=/path/to/policy.json
HIVE_ANSWER_MODEL=Qwen/Qwen3-VL-4B-Instruct
# Fill in the OpenAI-compatible API root for each service (including /v1).
HIVE_ANSWER_BASE_URL=
HIVE_EXECUTOR_MODEL=Qwen/Qwen3-VL-4B-Instruct
HIVE_EXECUTOR_BASE_URL=
HIVE_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
HIVE_EMBEDDING_DIM=2048
# Pin a Hugging Face commit for the local/query embedding model and embedding server.
# HIVE_EMBEDDING_REVISION=<full-model-commit>
HIVE_EMBEDDING_BASE_URL=
HIVE_JUDGE_MODEL=openai/gpt-4o-mini
HIVE_JUDGE_BASE_URL=
# HIVE_TOKENIZER=/path/to/complete-answer-processor  # Required locally for PPO cost rewards.
# HIVE_MEMORY_BANK=/path/to/memory-bank
# HIVE_QUERY_CACHE=/path/to/query-embeddings
# HIVE_GVV_RUN_DIR=/path/to/GVV-run
# HIVE_PYTHON=/path/to/venv/bin/python
# HIVE_CUDA_VISIBLE_DEVICES=0
# HIVE_WMA_FRAMEWORK_ROOT=/path/to/WorldMemArena  # Optional official evaluator.
ANSWER_API_KEY=
EXECUTOR_API_KEY=
EMBEDDING_API_KEY=
JUDGE_API_KEY=
# OPENAI_API_KEY=     # Optional fallback for all roles.
# OPENROUTER_API_KEY= # Optional provider fallback.
