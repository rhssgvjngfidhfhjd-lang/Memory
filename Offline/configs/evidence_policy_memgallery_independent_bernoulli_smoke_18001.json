{
  "benchmark": "memgallery",
  "data_source": "mem_gallery",
  "split_manifest": "multimodal_split_manifest.json",
  "seed": 42,
  "data_dir": "../Mem-Gallery/benchmark/data",
  "memory_bank": "outputs/Mem-Gallery/HiveMem/memory",
  "query_cache": "data/qwen3_vl_embedding_2b/query_embeddings",
  "profiles_file": "configs/profiles.json",
  "output_dir": "outputs/evidence_policy_memgallery_independent_bernoulli_smoke_18001_20260905",
  "top_k": 5,
  "excluded_categories": ["AR"],
  "visual_categories": ["VS", "VR", "TTL"],
  "evidence": {
    "schema_version": 2,
    "order": ["summary", "dialogue", "caption", "image", "vp"],
    "vp_run_dir": "../vp_extractor/outputs/qwen3vl4b_all_v1",
    "strict_vp_coverage": true,
    "max_vps_per_image": 5
  },
  "model": {
    "name": "Qwen/Qwen3-VL-4B-Instruct",
    "base_url": "http://127.0.0.1:18001/v1",
