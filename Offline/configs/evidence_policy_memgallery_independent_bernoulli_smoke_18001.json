  "ppo": {
    "learning_rate": 0.0003,
    "clip_ratio": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.01,
    "max_grad_norm": 1.0,
    "update_epochs": 4,
    "minibatch_size": 16,
    "rollout_batch_size": 16,
    "gamma": 1.0,
    "gae_lambda": 1.0,
    "epochs": 1,
    "validation_at_start": true,
    "validation_interval_fraction": 1.0,
    "validation_limit": 2
  }
