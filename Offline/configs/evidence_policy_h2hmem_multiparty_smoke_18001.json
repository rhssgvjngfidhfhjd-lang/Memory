{
  "benchmark": "h2hmem",
  "data_source": "h2hmem_multiparty",
  "split_manifest": "multimodal_split_manifest.json",
  "workspace_root": "..",
  "seed": 42,
  "data_dir": "../H2HMEM-main/dataset",
  "memory_bank": "outputs/H2HMEM_PPO/HiveMem/memory",
  "query_cache": "data/h2hmem_qwen3_vl_embedding_2b/query_embeddings",
  "output_dir": "outputs/evidence_policy_h2hmem_multiparty_smoke_18001",
  "top_k": 5,
  "graph_options": {
    "seed_k": 0,
    "mode": "append",
    "append_k": 2,
    "expansion_bonus": 0.2,
    "expand_temporal": true,
    "expand_related": true,
    "expand_entity": true,
    "expand_attribute": true,
    "df_max": 0.3,
    "df_stop": 0.5,
    "min_shared": 2,
    "degree_cap": 10
  },
  "visual_categories": [
    "Unimodal Precise Recall", "Cross-modal Related Retrieval",
    "Multimodal Causal Inference", "Reference & Evolution Tracking",
    "Conflict Detection", "Test-Time Learning", "Temporal Reasoning",
    "Knowledge Resolution", "Answer Refusal"
  ],
  "evidence": {
    "schema_version": 2,
    "order": ["summary", "dialogue", "caption", "image", "vp"],
    "vp_run_dir": "../vp_extractor/outputs/qwen3vl4b_all_v1",
    "strict_vp_coverage": true,
    "max_vps_per_image": 5
  },
  "model": {
    "name": "Qwen/Qwen3-VL-4B-Instruct",
    "base_url": "http://127.0.0.1:18001/v1",
    "api_key": "EMPTY",
    "max_tokens": 128,
    "timeout": 180,
    "retries": 2,
    "think": false
  },
  "policy": {
    "embedding_dim": 2048,
    "hidden_dim": 256,
    "hidden_layers": 3,
    "deterministic_threshold": 0.5,
    "initial_action_probability": 0.5
  },
  "ppo": {
    "learning_rate": 0.0003,
    "clip_ratio": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.01,
    "max_grad_norm": 1.0,
    "update_epochs": 1,
    "minibatch_size": 1,
    "rollout_batch_size": 1,
    "gamma": 1.0,
    "gae_lambda": 1.0,
    "epochs": 1,
    "validation_at_start": true,
    "validation_interval_fraction": 1.0,
    "validation_limit": 1
  }
}
