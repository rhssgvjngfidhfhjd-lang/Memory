{
  "vlm": {
    "model": "Qwen/Qwen3-VL-4B-Instruct",
    "api_key_env": "EXECUTOR_API_KEY",
    "temperature": 0.0,
    "max_tokens": 1024,
    "timeout_seconds": 180,
    "retries": 1,
    "enable_thinking": false
  },
  "discovery": {
    "max_views_per_image": 20,
    "dedup_iou": 0.6,
    "full_frame_area_threshold": 0.9,
    "enable_relocalization": true,
    "min_box_side_norm": 8
  },
  "crop": {
    "jpeg_quality": 95,
    "create_preview": true
  },
  "output": {
    "root": "outputs/gvv",
    "run_id": "default"
  },
  "prompts": "prompts/prompts.json"
}
