{
  "vlm": {
    "model": "Qwen/Qwen3-VL-4B-Instruct",
    "base_url": "http://127.0.0.1:18000/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.0,
    "max_tokens": 1024,
    "timeout_seconds": 180,
    "retries": 1,
    "enable_thinking": false
  },
  "discovery": {
    "max_primitives": 20,
    "dedup_iou": 0.6,
    "full_frame_area_threshold": 0.9,
    "enable_relocalization": true,
    "min_box_side_norm": 8
  },
  "crop": {
    "jpeg_quality": 95,
    "create_preview": true
  },
  "output": {
    "root": "outputs",
    "run_id": "qwen3vl4b_v1"
  },
  "prompts": {
    "discovery": "prompts/discovery_v1.txt",
    "caption_guided": "prompts/caption_guided_v1.txt",
    "relocalize": "prompts/relocalize_v1.txt"
  }
}
