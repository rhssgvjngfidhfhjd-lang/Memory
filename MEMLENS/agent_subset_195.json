  "reproduction": {
    "python_snippet": "import json\nsubset = set(json.load(open('agent_subset_195.json'))['question_ids'])\nfor ctx in ['32k', '64k', '128k', '256k']:\n    full = json.load(open(f'dataset_{ctx}.json'))\n    subset_records = [item for item in full if item['question_id'] in subset]\n    json.dump(subset_records, open(f'agent_subset_{ctx}.json', 'w'))",
    "notes": "All seven memory agents in the paper were evaluated on these exact 195 question_ids at all four context lengths (32K/64K/128K/256K). Direct VLMs are evaluated on the full 789-question benchmark in the main results, with a matched-subset re-scoring on this 195-subset reported in paper Table~\\ref{tab:agent_vs_vlm_195}."
