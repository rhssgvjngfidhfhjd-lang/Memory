{
  "schema_version": 1,
  "protocols": {
    "hivemem_graph": {
      "_comment": "Strict test-split HiVe_mem graph retrieval: five vector memories plus up to two graph neighbours.",
      "split": "test",
      "split_manifest": "benchmark://multimodal_split_manifest.json",
      "vector_top_k": 5,
      "graph_append_k": 2,
      "degree_cap": 4,
      "effective_top_k": 7,
      "graph_mode": "append",
      "expected_qa_counts": {
        "Mem-Gallery": 275,
        "H2HMEM": 360,
        "WorldMemArena": 440
      },
      "answer_model": "Qwen/Qwen3-VL-4B-Instruct",
      "answer_concurrency": 16,
      "sample_concurrency": 4,
      "executor_concurrency": 4,
      "executor_max_tokens": 1536,
      "request_timeout": 180,
      "retries": 2,
      "judge_workers": 32,
      "judge_timeout": 60,
      "judge_max_tokens": 512,
      "judge_api_key_env": "JUDGE_API_KEY"
    },
    "ppo": {
      "memgallery": {
        "data_source": "mem_gallery",
        "data_dir": "dataset://memgallery/",
        "memory_bank": "outputs/memory/memgallery",
        "output_dir": "outputs/evidence_policy/memgallery",
        "top_k": 7,
        "excluded_categories": [
          "AR"
        ],
        "visual_categories": [
          "VS",
          "VR",
          "TTL"
        ],
        "benchmark": "memgallery"
      },
      "h2hmem": {
        "benchmark": "h2hmem",
        "data_sources": [
          "h2hmem_dyadic",
          "h2hmem_multiparty"
        ],
        "data_dir": "dataset://h2hmem/",
        "memory_bank": "outputs/memory/h2hmem",
        "output_dir": "outputs/evidence_policy/h2hmem",
        "top_k": 5,
        "visual_categories": [
          "Unimodal Precise Recall",
          "Cross-modal Related Retrieval",
          "Multimodal Causal Inference",
          "Reference & Evolution Tracking",
          "Conflict Detection",
          "Test-Time Learning",
          "Temporal Reasoning",
          "Knowledge Resolution",
          "Answer Refusal"
        ]
      },
      "wma": {
        "benchmark": "wma",
        "data_source": "worldmemarena_lifelong",
        "data_dir": "dataset://wma/",
        "memory_bank": "outputs/memory/wma",
        "output_dir": "outputs/evidence_policy/wma",
        "top_k": 7,
        "excluded_categories": [
          "MB"
        ],
        "visual_categories": [
          "VFR",
          "VS",
          "VU",
          "CMR",
          ""
        ]
      }
    }
  }
}
