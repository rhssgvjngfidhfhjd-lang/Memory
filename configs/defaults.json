{
  "schema_version": 1,
  "runtime": {
    "answer_model": "Qwen/Qwen3-VL-4B-Instruct",
    "answer_temperature": 0.0,
    "num_predict": 512,
    "request_timeout": 120,
    "retries": 2,
    "think": false,
    "top_k": 5,
    "append_k": 2,
    "degree_cap": 4,
    "seed_k": 0,
    "executor_model": "Qwen/Qwen3-VL-4B-Instruct",
    "executor_max_tokens": 512,
    "executor_visual_input": "image",
    "executor_concurrency": 16,
    "sample_concurrency": 4,
    "answer_concurrency": 16,
    "checkpoint_every": 10,
    "judge_timeout": 60,
    "judge_max_tokens": 512,
    "judge_workers": 32,
    "judge_api_key_env": "JUDGE_API_KEY",
    "retrieval_memory_tokenizer": "Qwen/Qwen3-VL-4B-Instruct",
    "output_root": "outputs"
  },
  "ppo": {
    "learning_rate": 0.0003,
    "clip_ratio": 0.2,
    "value_coefficient": 0.5,
    "entropy_coefficient": 0.01,
    "max_grad_norm": 1.0,
    "update_epochs": 4,
    "minibatch_size": 16,
    "rollout_batch_size": 16,
    "gamma": 1.0,
    "gae_lambda": 1.0,
    "epochs": 6,
    "validation_at_start": true,
    "validation_interval_fraction": 0.5,
    "validation_limit": 0
  },
  "evidence_policy": {
    "split_manifest": "benchmark://multimodal_split_manifest.json",
    "seed": 42,
    "graph_options": {
      "seed_k": 0,
      "mode": "append",
      "append_k": 2,
      "degree_cap": 4,
      "attribute_weighting": "idf"
    },
    "evidence": {
      "schema_version": 2,
      "order": [
        "summary",
        "raw_interaction_text",
        "caption",
        "image",
        "gvv"
      ],
      "gvv_run_dir": "outputs/gvv/default",
      "strict_gvv_coverage": true,
      "max_views_per_image": 5
    },
    "model": {
      "name": "Qwen/Qwen3-VL-4B-Instruct",
      "max_tokens": 512,
      "timeout": 180,
      "retries": 2,
      "think": false,
      "api_key_env": "ANSWER_API_KEY"
    },
    "policy": {
      "hidden_dim": 256,
      "hidden_layers": 3,
      "deterministic_threshold": 0.5,
      "initial_action_probability": 0.5
    },
    "reward": {
      "cost_enabled": true,
      "cost_tradeoff_lambda": 0.1,
      "cost_transform": "sqrt_incremental",
      "tokenizer_name": "Qwen/Qwen3-VL-4B-Instruct",
      "window_size": 512,
      "min_window_size": 128,
      "lower_quantile": 0.05,
      "upper_quantile": 0.95,
      "initial_range_floor_ratio": 0.25,
      "range_epsilon": 1e-12,
      "std_epsilon": 1e-08
    }
  },
  "model_efficiency": {
    "schema_version": 1,
    "models": {
      "Qwen/Qwen3-VL-4B-Instruct": {
        "latency": {
          "base_seconds": 0.332,
          "input_seconds_per_token": 3e-06,
          "output_seconds_per_token": 0.00664,
          "image_seconds": 0.15,
          "source": "inherited_qwen3_4b_text_with_heuristic_image_proxy"
        },
        "pricing": {
          "input_per_million_usd": 0.05,
          "output_per_million_usd": 0.25,
          "source": "openrouter_reference"
        }
      }
    }
  },
  "dataset_sources": {
    "memgallery": {
      "repo_id": "Ethan-Bei/Mem-Gallery"
    },
    "h2hmem": {
      "repo_id": "varib/H2HMEM"
    },
    "wma": {
      "repo_id": "LCZZZZ/WorldMemArena"
    }
  }
